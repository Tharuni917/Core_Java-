Program 13:(Even and Odd)

public class datatypes {
    public static void main(String[] args) {

        System.out.println("EVEN TABLES");

        for(int i = 1; i <= 40; i++) {

            if(i % 2 == 0) {

                System.out.println("\nTable of " + i);

                for(int j = 1; j <= 10; j++) {
                    System.out.println(i + " x " + j + " = " + (i*j));
                }
            }
        }

        System.out.println("\nODD TABLES");

        for(int i = 1; i <= 40; i++) {

            if(i % 2 != 0) {

                System.out.println("\nTable of " + i);

                for(int j = 1; j <= 10; j++) {
                    System.out.println(i + " x " + j + " = " + (i*j));
                }
            }
        }
    }
}
